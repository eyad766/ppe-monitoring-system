# Copy this file to ".env" to override defaults (install.bat does it for you).

# Web server. Use APP_HOST=0.0.0.0 to open the dashboard from other devices on the network
# (e.g. http://<this-PC-IP>:8000 from a phone or another PC).
APP_HOST=127.0.0.1
APP_PORT=8000
OPEN_BROWSER=1

# Database. SQLite for the demo; PostgreSQL for production, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ppe_monitoring
# DATABASE_URL=

# AI models (defaults are the files inside the models folder)
# PPE_MODEL_PATH=models/ppe_yolov8n.pt
# PERSON_MODEL_PATH=models/person_yolov8n_coco.pt
# REID_MODEL_PATH=models/reid_lmbn_n_market.onnx

# auto = use an NVIDIA GPU when the CUDA build of PyTorch is installed, otherwise CPU. Or: cpu / 0
INFERENCE_DEVICE=auto

# Optional: initial Telegram values (can also be set in the Settings page)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
